<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/lukiest_guy</item>
        <item name="android:textColor">@color/colorTitle</item>
        <item name="android:textSize">55sp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="SubtitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/lukiest_guy</item>
        <item name="android:textColor">@color/colorTitle</item>
        <item name="android:textSize">30sp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="LabelStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">310dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorFormText</item>
    </style>

    <style name="EditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">310dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@color/colorSecondaryLight</item>
        <item name="android:backgroundTint">@color/colorSecondaryLight</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorFormText</item>
        <item name="android:textColorHint">@color/colorFormText</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">310dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorButtonText</item>
    </style>

    <style name="ToggleButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@color/colorSecondaryLight</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.Design.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:background">@color/colorPrimary</item>
    </style>

    <style name="DropdownStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">310dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorFormText</item>
        <item name="android:background">@android:drawable/btn_dropdown</item>
    </style>

</resources>